# 本文件仅说明变量格式，不能直接用于部署；实际值应写入仓库外、受控且未跟踪的 env 文件。
PILOT_WEB_IMAGE=opsai-it-pilot-web:local
PILOT_HTTPS_DOMAIN=kb-pilot.example.internal
PILOT_HTTP_PORT=8080
PILOT_HTTPS_PORT=8443
PILOT_TLS_CERTS_DIR=/srv/opsai-it/tls

DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
DJANGO_ALLOWED_HOSTS=kb-pilot.example.internal
DJANGO_CSRF_TRUSTED_ORIGINS=https://kb-pilot.example.internal
DJANGO_TIME_ZONE=Asia/Shanghai
DJANGO_LOG_LEVEL=INFO

POSTGRES_DB=opsai_pilot
POSTGRES_USER=opsai_pilot
POSTGRES_PASSWORD=REPLACE_WITH_A_UNIQUE_DATABASE_PASSWORD
