# 仅用于内网试点；证书和私有密钥必须由受控仓库外路径提供。
http://{$PILOT_HTTPS_DOMAIN} {
	redir https://{$PILOT_HTTPS_DOMAIN}:{$PILOT_HTTPS_PORT}{uri} permanent
}

https://{$PILOT_HTTPS_DOMAIN} {
	tls /etc/caddy/tls/tls.crt /etc/caddy/tls/tls.key

	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
	}

	@private_media path /media/*
	respond @private_media "Not Found" 404

	handle_path /static/* {
		root * /srv/static
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	reverse_proxy web:8000 {
		header_up X-Forwarded-Proto https
		header_up X-Real-IP {remote_host}
	}
}
