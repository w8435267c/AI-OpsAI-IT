# OpsAI-IT 本地开发环境变量示例。
# 使用方法：复制本文件为 .env 并替换下面的占位值；.env 已被 Git 忽略，不得提交。

# Django 运行环境与基础配置
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-local-development-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL（由 deploy/compose.yaml 的 db 服务提供）
# 宿主机（Windows）直接运行 Django 时保持 POSTGRES_HOST=localhost；
# Compose 的 web 服务会自动覆盖为 POSTGRES_HOST=db，无需修改本文件。
POSTGRES_DB=opsai_it_dev
POSTGRES_USER=opsai_app
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
